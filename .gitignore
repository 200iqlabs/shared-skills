# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code local settings
.claude/settings.local.json

# Firecrawl scrape cache
.firecrawl/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# Skill workspaces (eval outputs from skill-creator)
skills/*-workspace/

# Packages
*.skill

# Context files (user-specific data, not tracked)
context/*.md
!context/README.md

# Company data (user-specific, not tracked) — read by legal, tax-advisor, cfo, linkedin-content and /ss:slides:init
company/data/*.md
company/brand/

# Sensitive data
*.key
*.pem
*.p12

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# review-loop run log — written by the review-loop skill in the repository root, never committed.
.review-loop.log
